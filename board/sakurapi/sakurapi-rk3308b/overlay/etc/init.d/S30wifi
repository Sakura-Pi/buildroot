#!/bin/sh
#
# Load WiFi driver and start wpa_supplicant
#

DAEMON="wpa_supplicant"
PIDFILE="/var/run/$DAEMON.pid"

case "$1" in
  start)
    printf "Loading brcmfmac WiFi driver: "
    modprobe brcmfmac
    [ $? -eq 0 ] && echo "OK" || echo "FAIL"

    # Wait for wlan0 to appear
    for i in $(seq 1 10); do
      [ -d /sys/class/net/wlan0 ] && break
      sleep 0.5
    done

    if [ -d /sys/class/net/wlan0 ]; then
      printf "Starting $DAEMON: "
      start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/sbin/wpa_supplicant -- \
        -i wlan0 -c /etc/wpa_supplicant.conf -B
      [ $? -eq 0 ] && echo "OK" || echo "FAIL"
    else
      echo "wlan0 not found, skipping wpa_supplicant"
    fi
    ;;
  stop)
    printf "Stopping $DAEMON: "
    start-stop-daemon -K -p "$PIDFILE" -x /usr/sbin/wpa_supplicant
    [ $? -eq 0 ] && echo "OK" || echo "FAIL"
    rm -f "$PIDFILE"

    printf "Unloading brcmfmac: "
    rmmod brcmfmac 2>/dev/null
    echo "OK"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
